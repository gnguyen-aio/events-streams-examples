                      "config": {
                        "script": "\tproject \u003d \"event-streams\"\n\tpath \u003d \"exchange/event-streams/source-event-listener\"\n\tacknowledge \u003d True\n\t\n\tmessage \u003d self.getSibling(\"TextField\").props.text\n\t#https://docs.inductiveautomation.com/docs/8.3/appendix/scripting-functions/system-eventstream/system-eventstream-publishEvent\n\tsystem.eventstream.publishEvent(project, path, message, acknowledge)"
