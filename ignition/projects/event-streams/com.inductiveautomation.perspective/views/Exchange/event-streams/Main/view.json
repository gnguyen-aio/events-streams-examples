          {
            "children": [
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\t#https://docs.chariot.io/display/CLD83/MQTT+Publishing+via+MQTT+Transmission\n\t#https://docs.chariot.io/display/CLD83/MQTT+Engine+Event+Streams#:~:text\u003dSetting%20up%20MQTT%20Event%20Stream%20Source\n\t\n\tmqttServerName \u003d \u0027Chariot SCADA\u0027 #The server name as shown in the MQTT Transmission Settings configuration shown below\n\ttopic \u003d \u0027EventStreams\u0027 #The MQTT Topic to publish on, this needs to be the same name that is defined in the source-mqtt event stream\n\tpayload \u003d system.util.jsonEncode([{\u0027message\u0027: \u0027hello world\u0027}])\n\tqos \u003d 0\n\tretained \u003d False\n\tsystem.cirruslink.transmission.publish(mqttServerName, topic, payload, qos, retained)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
