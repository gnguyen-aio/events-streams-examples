{
  "enabled": true,
  "source": {
    "type": "ignition.tagEvent",
    "config": {
      "paths": [
        "[default]Exchange/event-streams/source-tag-event/trigger"
      ],
      "changeTypes": [
        "VALUE",
        "QUALITY",
        "TIMESTAMP"
      ],
      "skipInitialValues": true
    }
  },
  "sourceEncoder": {
    "type": "ignition.jsonObject",
    "properties": {
      "encoding": "UTF-8"
    }
  },
  "handlers": [
    {
      "enabled": true,
      "type": "ignition.logger",
      "config": {
        "name": {
          "data": "\"Logger Handler | source-tag-event Event Stream\"",
          "type": "EXPRESSION"
        },
        "logLevel": "INFO",
        "message": {
          "data": "\"Data: \"+{event.data} + \" Metadata: \" + {event.metadata}",
          "type": "EXPRESSION"
        }
      },
      "failureStrategy": {
        "type": "ABORT",
        "retryPolicy": null
      }
    }
  ],
  "batch": {
    "debounceMs": 100,
    "maxWaitMs": 1000,
    "maxQueueSize": 0,
    "overflow": "DROP_OLDEST"
  },
  "filter": {
    "enabled": false,
    "userCode": "\treturn True"
  },
  "transform": {
    "enabled": false,
    "userCode": "\treturn event.data"
  },
  "transformEncoder": {
    "type": "ignition.jsonObject",
    "properties": {
      "encoding": "UTF-8"
    }
  },
  "onError": {
    "enabled": false,
    "userCode": ""
  }
}