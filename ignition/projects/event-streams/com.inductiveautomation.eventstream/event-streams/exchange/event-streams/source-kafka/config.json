{
  "enabled": true,
  "source": {
    "type": "com.inductiveautomation.connectors.kafka.eventstream.source",
    "config": {
      "type": "ConsumerGroup",
      "connector": "kafka",
      "topic": "data-to-ignition",
      "groupId": "ignition-data",
      "partition": 0,
      "offset": 0,
      "pollTimeoutMs": 100,
      "maxPollRecords": 500,
      "autoOffsetReset": "Latest",
      "commitType": "Auto",
      "properties": []
    }
  },
  "sourceEncoder": {
    "type": "ignition.jsonObject",
    "properties": {
      "encoding": "UTF-8"
    }
  },
  "handlers": [
    {
      "enabled": true,
      "type": "ignition.logger",
      "config": {
        "name": {
          "data": "\"Logger Handler | source-kafka Event Stream\"",
          "type": "EXPRESSION"
        },
        "logLevel": "INFO",
        "message": {
          "data": "\u0027Data: \u0027+ {event.data}+ \u0027 Metadata: \u0027+ {event.metadata}",
          "type": "EXPRESSION"
        }
      },
      "failureStrategy": {
        "type": "ABORT",
        "retryPolicy": null
      }
    }
  ],
  "batch": {
    "debounceMs": 100,
    "maxWaitMs": 1000,
    "maxQueueSize": 0,
    "overflow": "DROP_OLDEST"
  },
  "filter": {
    "enabled": false,
    "userCode": "\treturn True"
  },
  "transform": {
    "enabled": false,
    "userCode": "\treturn event.data"
  },
  "transformEncoder": {
    "type": "ignition.jsonObject",
    "properties": {
      "encoding": "UTF-8"
    }
  },
  "onError": {
    "enabled": false,
    "userCode": ""
  }
}