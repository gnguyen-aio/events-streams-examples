{
  "custom": {
    "showDetails": false
  },
  "params": {
    "body": "value",
    "error": "",
    "id": "value",
    "title": "value"
  },
  "propConfig": {
    "custom.showDetails": {
      "persistent": true
    },
    "params.body": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.error": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.id": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 304,
      "width": 520
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Fail Icon"
            },
            "position": {
              "basis": "20px"
            },
            "props": {
              "color": "--neutral-10",
              "path": "material/error",
              "style": {
                "marginLeft": "6px"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "basis": "10px",
              "display": false,
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "--neutral-10",
                "fontSize": 20,
                "fontWeight": "bold",
                "marginLeft": "2px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t# close the popup using the \u0027id\u0027 that was passed in as a param\n\t\n\tsystem.perspective.closePopup(self.view.params.id)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "20px"
            },
            "props": {
              "color": "--neutral-10",
              "path": "material/close",
              "style": {
                "classes": "exchange/alarm-configurator/icon",
                "marginBottom": "15px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "35px",
          "shrink": 0
        },
        "props": {
          "justify": "space-between",
          "style": {
            "classes": "exchange/alarm-configurator/color"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Body"
        },
        "position": {
          "basis": "50px",
          "display": false,
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.body"
              },
              "transforms": [
                {
                  "code": "\t# return the \u0027body\u0027 param value (display main message for the user)\n\t\n\treturn value",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "--neutral-10",
            "borderStyle": "none",
            "color": "--neutral-100",
            "cursor": "default",
            "fontFamily": "Helvetica",
            "fontSize": 17,
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Body"
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "!{view.custom.showDetails}"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.body"
                  },
                  "transforms": [
                    {
                      "code": "\t# return the \u0027body\u0027 param value (display main message for the user)\n\t\n\treturn value",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "borderStyle": "none",
                "color": "--neutral-100",
                "cursor": "default",
                "fontFamily": "Helvetica",
                "fontSize": 17,
                "fontWeight": "bold",
                "marginBottom": "10px",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t# toggle the visibility of the text area displaying the error\n\tself.view.custom.showDetails \u003d not self.view.custom.showDetails"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Show Details"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.showDetails"
                  },
                  "transforms": [
                    {
                      "code": "\tif value:\n\t\treturn \u0027Hide Details\u0027\n\telse:\n\t\treturn \u0027Show Details\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "borderStyle": "none",
                "color": "--neutral-60",
                "cursor": "pointer",
                "fontFamily": "Helvetica",
                "fontSize": "12px",
                "fontWeight": "bolder",
                "textAlign": "center",
                "textDecoration": "underline"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Body Cont"
        },
        "propConfig": {
          "position.grow": {
            "binding": {
              "config": {
                "expression": "if(!{view.custom.showDetails}\u003dtrue,1,0)"
              },
              "type": "expr"
            }
          },
          "props.style.marginBottom": {
            "binding": {
              "config": {
                "expression": "if({view.custom.showDetails},\u002710px\u0027,\u00270px\u0027)"
              },
              "type": "expr"
            }
          },
          "props.style.marginTop": {
            "binding": {
              "config": {
                "expression": "if({view.custom.showDetails},\u002710px\u0027,\u00270px\u0027)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "justify": "center"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Error"
        },
        "position": {
          "basis": "100px",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.showDetails"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.error"
              },
              "transforms": [
                {
                  "code": "\treturn str(value).replace(\u0027\\\\n\u0027,\u0027\u003cbr\u003e\u0027)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "enabled": false,
          "style": {
            "backgroundColor": "--neutral-10",
            "color": "--neutral-100",
            "cursor": "text",
            "marginBottom": "15px",
            "marginLeft": "25px",
            "marginRight": "25px"
          }
        },
        "type": "ia.input.text-area"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# close the popup using the \u0027id\u0027 param\n\t\n\tsystem.perspective.closePopup(self.view.params.id)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Okay"
        },
        "position": {
          "basis": "34px"
        },
        "props": {
          "style": {
            "classes": "exchange/alarm-configurator/color",
            "marginBottom": "10px",
            "marginLeft": "25px",
            "marginRight": "25px"
          },
          "text": "Okay"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}