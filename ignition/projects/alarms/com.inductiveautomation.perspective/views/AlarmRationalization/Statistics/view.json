  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "AlarmRationalization/Label"
              },
              "text": "Total Tags"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "now(0)"
                  },
                  "transforms": [
                    {
                      "code": "\ttry:\n\t\tfrom com.inductiveautomation.ignition.gateway import IgnitionGateway\n\t\tcontext \u003d IgnitionGateway.get()\n\t\ttagManager \u003d context.getTagManager()\n\t\ttagCount \u003d 0\n\t\tfor tagProvider in tagManager.getTagProviders():\n\t\t\ttagCount +\u003d tagProvider.getStatusInformation().get().getTagCount()\n\t\treturn tagCount\n\texcept:\n\t\treturn 0",
                      "type": "script"
                    },
                    {
                      "expression": "if({value} \u003d null, 0, numberFormat({value}, \"#,##0\"))",
                      "type": "expression"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "AlarmRationalization/Value"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Total Tags"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "AlarmRationalization/Row"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
