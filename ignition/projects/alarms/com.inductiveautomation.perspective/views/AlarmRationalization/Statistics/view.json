      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\n\timport java.lang.Exception\n\n\ttry:\n\t\tAlarmRationalization.Alarms.checkAlarms()\n\t\t\n\texcept (Exception, java.lang.Exception) as e:\n\t\t\n\t\tsystem.util.getLogger(\"AlarmRationalization.Dashboard.CheckNowButton\").error(\"%s\" % e)\n\t\t\n\t\terror \u003d \"\"\"\n\t\t\tUnable to check alarms. \n\t\t\tVerify the resource is configured correctly. \n\t\t\tFor more information, see Gateway log.\n\t\t\"\"\"\n\t\tsystem.perspective.openPopup(\n\t\t\t\u0027message\u0027,\n\t\t\t\u0027AlarmRationalization/Message\u0027, \n\t\t\tparams \u003d {\"display\": error, \"class\": \"SmallText\"}, \n\t\t\tresizable \u003d True,\n\t\t\tmodal \u003d True\n\t\t)\n\t# re-enable the button\n\tfinally:\n\t\tsystem.tag.writeBlocking([\"AlarmRationalization/Running\"], [False])"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Check Now"
        },
        "position": {
          "basis": "34px"
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{AlarmRationalization/Running}"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({AlarmRationalization/Running}, \"Running...\", \"Check Now\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "image": {
            "icon": {
              "path": "material/refresh"
            }
          },
          "style": {
            "marginTop": "5px"
          }
        },
        "type": "ia.input.button"
      }
    ],
