          {
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "struct": {
                      "alarmsWithRationalization": "{AlarmRationalization/AlarmsWithRationalization}",
                      "alarmsWithoutRationalization": "{AlarmRationalization/AlarmsWithoutRationalization}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\treturn len(value[\"alarmsWithoutRationalization\"]) + len(value[\"alarmsWithRationalization\"])",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "style": {
                "classes": "AlarmRationalization/Value"
              }
            },
            "type": "ia.display.label"
          }
